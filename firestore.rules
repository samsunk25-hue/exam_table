rules_version = '2';

// 권한 원칙 (PRD 6.3)
// - 역할은 Custom Claims(role: ADMIN | TEACHER, teacherId)로 판단
// - 관리자 쓰기는 updatedBy == 본인 uid 를 강제해 Audit Log에 행위자를 남긴다
// - auditLogs, loadLedger, runs, assignments, busy, admins, 세션 status 는 Cloud Functions 전용
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'ADMIN'; }
    function isTeacher() { return signedIn() && request.auth.token.role == 'TEACHER'; }
    function isMember() { return isAdmin() || isTeacher(); }
    function myTeacherId() { return request.auth.token.teacherId; }
    function stamped() { return request.resource.data.updatedBy == request.auth.uid; }

    // 학교별 분리: 교사는 로그인 정보(Custom Claims)의 학교·학기와 같은 자료만 읽는다
    function myTerm() { return request.auth.token.get('term', ''); }
    function inMyTerm(data) { return isTeacher() && myTerm() != '' && data.get('term', '') == myTerm(); }
    function sessionInMyTerm(data) {
      return isTeacher() && myTerm() != ''
        && data.schoolName == request.auth.token.school
        && data.year == request.auth.token.year
        && data.semester == request.auth.token.semester;
    }
    function teacherSeesSession(sid) {
      return sessionInMyTerm(get(/databases/$(database)/documents/sessions/$(sid)).data);
    }

    function sessionStatus(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data.status;
    }
    function setupEditable(sid) {
      return sessionStatus(sid) in ['DRAFT', 'AUTO_ASSIGNED', 'REVIEW'];
    }
    function published(sid) {
      return sessionStatus(sid) in ['PUBLISHED', 'SWAP', 'CONFIRMED', 'LOCKED'];
    }
    function adminSetupWrite(sid) {
      return isAdmin() && setupEditable(sid) && (request.method == 'delete' || stamped());
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // 가입·관리자 권한 신청: 본인이 대기 상태로만 작성(반려되면 다시 신청), 승인·반려는 함수만
    match /accessRequests/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.kind in ['TEACHER', 'ADMIN']
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        // 교사 가입은 소속 학교·학년도·학기가 필요
        && (request.resource.data.kind != 'TEACHER'
          || (request.resource.data.school is string && request.resource.data.school.size() > 0
            && request.resource.data.year is int && request.resource.data.semester in [1, 2]))
        && (resource == null || resource.data.status != 'APPROVED' || request.resource.data.kind != resource.data.kind);
      allow delete: if false;
    }

    // 관리자 목록: addAdmin / removeAdmin 함수로만 변경
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 학교·학기별 명단 (교사는 자기 학교·학기 명단과 본인 문서만)
    match /teachers/{teacherId} {
      allow read: if isAdmin() || inMyTerm(resource.data) || (isTeacher() && teacherId == myTeacherId());
      allow create, update: if isAdmin() && stamped();
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isAdmin() || inMyTerm(resource.data);
      allow create, update: if isAdmin() && stamped();
      allow delete: if isAdmin();
    }

    // 되돌리기 기록: 관리자가 본인 이름으로 새 기록만 남길 수 있고, 되돌림 표시는 undoOperation 함수만
    match /undoOps/{opId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.undone == false;
      allow update, delete: if false;

      match /snapshots/{n} {
        allow read: if isAdmin();
        allow create: if isAdmin() && getAfter(/databases/$(database)/documents/undoOps/$(opId)).data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 앱 알림: 함수만 만든다. 교사는 본인 알림의 read만, 관리자는 관리자 알림의 readBy에 본인만 추가
    match /notifications/{id} {
      allow read: if (isAdmin() && resource.data.audience == 'ADMIN')
        || (isTeacher() && resource.data.teacherId == myTeacherId());
      allow update: if (isTeacher() && resource.data.teacherId == myTeacherId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (isAdmin() && resource.data.audience == 'ADMIN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          && request.auth.uid in request.resource.data.readBy);
      allow create, delete: if false;
    }

    match /loadLedger/{ledgerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sessions/{sid} {
      allow read: if isAdmin() || sessionInMyTerm(resource.data);
      allow create: if isAdmin() && stamped() && request.resource.data.status == 'DRAFT';
      allow update: if isAdmin() && stamped()
        && request.resource.data.status == resource.data.status;
      allow delete: if isAdmin() && resource.data.status == 'DRAFT';

      // 교사별 문서 1개 (entries 배열)
      match /baseTimetable/{teacherId} {
        allow read: if isAdmin();
        allow write: if adminSetupWrite(sid);
      }

      // 시험 1건 = 문서 1개, 시험실 배치는 rooms 배열
      match /slots/{id} {
        allow read: if isAdmin() || teacherSeesSession(sid);
        allow write: if adminSetupWrite(sid);
      }

      match /constraints/{id} {
        allow read: if isAdmin();
        allow write: if adminSetupWrite(sid);
      }

      // 교사: 본인 불가시간을 대기(PENDING) 상태로만 제출/수정/삭제
      match /availability/{id} {
        allow read: if isAdmin() || (isTeacher() && resource.data.teacherId == myTeacherId());
        allow create: if isTeacher() && stamped()
          && teacherSeesSession(sid)
          && setupEditable(sid)
          && request.resource.data.teacherId == myTeacherId()
          && request.resource.data.status == 'PENDING'
          && request.resource.data.source == 'TEACHER';
        allow update: if isTeacher() && stamped()
          && setupEditable(sid)
          && resource.data.teacherId == myTeacherId()
          && resource.data.status == 'PENDING'
          && request.resource.data.teacherId == myTeacherId()
          && request.resource.data.status == 'PENDING'
          && request.resource.data.source == 'TEACHER';
        // 본인 제출은 승인된 뒤에도 교사 공개 전까지 취소(삭제)할 수 있다
        allow delete: if isTeacher()
          && setupEditable(sid)
          && resource.data.teacherId == myTeacherId();
        allow write: if isAdmin() && (request.method == 'delete' || stamped());
      }

      match /assignments/{id} {
        allow read: if isAdmin() || (teacherSeesSession(sid) && published(sid));
        allow write: if false;
      }

      // 교사 교환 요청: 관련 교사(parties)와 관리자만 읽고, 쓰기는 함수만
      match /swapRequests/{id} {
        allow read: if isAdmin() || (teacherSeesSession(sid) && myTeacherId() in resource.data.parties);
        allow write: if false;
      }

      match /runs/{id} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /busy/{id} {
        allow read, write: if false;
      }

      match /auditLogs/{id} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
  }
}
