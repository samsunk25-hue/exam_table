{
  "name": "smart-invigilation-manager",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "emulators": "npm run build -w functions && firebase emulators:start",
    "dev:emu": "npm run dev:emu -w apps/web",
    "seed": "npm run seed -w functions",
    "e2e": "node scripts/e2e/download-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
